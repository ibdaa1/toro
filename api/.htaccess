RewriteEngine On

# Pass Authorization header to PHP (needed for LiteSpeed / some Apache setups)
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Pass X-Token header through
RewriteCond %{HTTP:X-Token} .
RewriteRule .* - [E=HTTP_X_TOKEN:%{HTTP:X-Token}]

# NOTE: CORS headers are set by PHP (api/config/cors.php) — do NOT add
# "Header always set" directives here; mod_headers may be unavailable on
# InfinityFree / LiteSpeed shared hosting and would cause a 500 error.
