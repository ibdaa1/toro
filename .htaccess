# ─────────────────────────────────────────────────────────────
# Root .htaccess — InfinityFree / LiteSpeed
# ─────────────────────────────────────────────────────────────

# Prevent directory listing
Options -Indexes

# Serve index.php before index.html so security headers are always set
DirectoryIndex index.php index.html

# ── Block sensitive version-control / config dirs ────────────
# These are matched as URL paths and returned as 404 so attackers
# get no information about whether the directory exists.
# RedirectMatch uses mod_alias which is always available on LiteSpeed.
RedirectMatch 404 /\.git(/.*)?$
RedirectMatch 404 /\.env(/.*)?$
RedirectMatch 404 /\.svn(/.*)?$
RedirectMatch 404 /\.hg(/.*)?$

# ── MIME type for PWA manifest ───────────────────────────────
# Serve manifest.json with the correct PWA manifest MIME type.
# Scoped to manifest.json only so other .json files are unaffected.
# ForceType/AddType use mod_mime which is available on LiteSpeed,
# unlike mod_headers which is not.
<Files "manifest.json">
    ForceType application/manifest+json
</Files>

# ── HTTP → HTTPS redirect ─────────────────────────────────────
# InfinityFree uses Openresty as a reverse proxy: SSL is terminated at
# the proxy and all backend requests arrive as HTTP, so %{HTTPS} is
# always "off".  The proxy signals the original protocol via the
# X-Forwarded-Proto header ("http" or "https").
# We redirect only when BOTH indicators confirm a plain-HTTP connection:
#   1. %{HTTPS} is "off"  (direct connection not encrypted)
#   2. X-Forwarded-Proto is not "https"  (proxy did not terminate HTTPS)
# Using AND logic prevents infinite redirect loops for HTTPS users whose
# requests arrive at LiteSpeed without the %{HTTPS}=on flag.
RewriteEngine On

# ── HTTP → HTTPS redirect ─────────────────────────────────────
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── Route direct index.html requests through index.php ────────
# Ensures security headers are set even when the file is requested
# by its exact name (e.g., by the Sucuri / Observatory scanner).
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?/]
RewriteRule ^index\.html$ /index.php [L,R=301]

